# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.

# Required. A Postgres connection string (e.g. from Neon: neon.tech).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional. Enables email notifications when a buyer sends a marketplace
# inquiry. Without this, inquiries are still saved and visible via the
# seller's manage link — this just skips the email. Get a key from
# resend.com.
RESEND_API_KEY=

# Optional. Sender address for those emails. Defaults to Resend's shared
# test sender if unset (fine for trying things out; verify your own domain
# in Resend before relying on this for real).
EMAIL_FROM=

# Optional. Used to build links back to a listing in notification emails.
# Defaults to blank (relative links) if unset.
PUBLIC_BASE_URL=

# Optional. Where the general site contact form (contact.html) sends its
# notification email. Without this (or without RESEND_API_KEY), messages
# are still saved to the database, just not emailed anywhere.
ADMIN_EMAIL=
